# Copy this to .env and fill in real values before running docker compose up.
# Never commit the actual .env file.

POSTGRES_USER=portal_admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=student_portal

RABBITMQ_USER=portal
RABBITMQ_PASSWORD=changeme

# WINDOWS ONLY — uncomment the line below if `docker compose logs gateway`
# shows repeated "Error response from daemon" errors. Requires enabling
# "Expose daemon on tcp://localhost:2375 without TLS" in Docker Desktop
# Settings > General first. See README.md for the full walkthrough.
# DOCKER_ENDPOINT=tcp://host.docker.internal:2375
