# Copy this to .env and fill in real values before running docker compose up.
# Never commit the actual .env file.

POSTGRES_USER=portal_admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=student_portal

RABBITMQ_USER=portal
RABBITMQ_PASSWORD=changeme

# pgAdmin web UI login (http://localhost:5050). Must be a valid-looking email;
# pgAdmin rejects reserved domains such as .local or .test.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=changeme

# Auth Service — signs every access token. Use a long random value outside
# local dev, e.g. `openssl rand -base64 48`.
JWT_SECRET=dev_secret_change_me
# First admin account, created on startup if it doesn't exist yet.
BOOTSTRAP_ADMIN_EMAIL=admin@portal.local
BOOTSTRAP_ADMIN_PASSWORD=admin_dev_pw

# MinIO object storage (console at http://localhost:9001). Password must be
# at least 8 characters or MinIO refuses to start.
MINIO_USER=portal_admin
MINIO_PASSWORD=changeme123

# Notification Service — Gmail SMTP. GMAIL_APP_PASSWORD is a 16-character
# Google "App password" (needs 2-Step Verification), NOT your Gmail password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Dev safety: send every notification to this inbox instead of the real
# recipient (demo accounts use made-up addresses). Leave empty in production.
NOTIFICATION_REDIRECT_TO=

# Grafana login (http://localhost:3001).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# WINDOWS ONLY — uncomment the line below if `docker compose logs gateway`
# shows repeated "Error response from daemon" errors. Requires enabling
# "Expose daemon on tcp://localhost:2375 without TLS" in Docker Desktop
# Settings > General first. See README.md for the full walkthrough.
# DOCKER_ENDPOINT=tcp://host.docker.internal:2375
